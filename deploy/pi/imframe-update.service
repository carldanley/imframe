[Unit]
Description=Handle imframe software updates
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/default/imframe
ExecStart=/usr/bin/python3 /usr/local/libexec/imframe/agent.py
TimeoutStartSec=10min
UMask=0077
