# Immich's base URL, without /api.
IMMICH_URL=http://immich.local:2283
# Create an API key in Immich > Account settings > API keys.
# Permissions: album.read, asset.read, asset.view, asset.download
IMMICH_API_KEY=
# Optional runtime settings:
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data
# For compose.ghcr.yaml, set your published image (use a lowercase owner/repo):
# Tags: latest = stable releases, 0.2 = patch updates, 0.2.0 = a specific release.
# IMFRAME_IMAGE=ghcr.io/your-account/imframe:0.2.0
