{
  "name": "imframe",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "oxlint --deny-warnings src server shared scripts tests vite.config.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:container": "node scripts/smoke-container.mjs",
    "test:pi": "node --test scripts/pi-*.test.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "version:bump": "npm version --no-git-tag-version",
    "release:check": "node scripts/release.mjs",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env build/server/server/index.js",
    "demo": "node scripts/dev.mjs --demo",
    "dev:hub": "node scripts/dev-hub.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
